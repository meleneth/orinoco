<div class="absolute left-6 top-6 flex w-[calc(100vw-3rem)] flex-nowrap items-start gap-3 text-white">
  <section class="w-72 shrink-0 rounded-md border border-slate-700 bg-slate-950/85 px-4 py-3 shadow-lg backdrop-blur">
    <div class="text-xs font-semibold uppercase text-cyan-300"><%= status_text %></div>
    <% if letters.present? %>
      <div class="mt-2 font-mono text-3xl font-bold"><%= letters %></div>
    <% else %>
      <div class="mt-2 text-sm text-slate-300">No board recognized yet.</div>
    <% end %>

    <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-slate-300">
      <div>Ruleset</div>
      <div class="text-right font-mono text-slate-100"><%= ruleset["mode"].presence || "unknown" %></div>
      <div>Hidden</div>
      <div class="text-right font-mono text-slate-100"><%= ruleset.fetch("hidden_letters", 0) %></div>
      <div>Fake</div>
      <div class="text-right font-mono text-slate-100"><%= ruleset.fetch("fake_letters", 0) %></div>
      <div>Updated</div>
      <div class="text-right font-mono text-slate-100"><%= updated_at.presence || "never" %></div>
    </div>
  </section>

  <section class="w-[34rem] shrink-0 rounded-md border border-slate-700 bg-slate-950/85 px-4 py-3 shadow-lg backdrop-blur">
    <div class="text-xs font-semibold uppercase text-cyan-300">Words</div>
    <% if remaining_words.present? %>
      <div class="mt-2 flex flex-wrap gap-2 text-xs">
        <% remaining_words.each do |entry| %>
          <span class="rounded border border-slate-600 px-2 py-1 font-mono text-slate-100"><%= remaining_word_label(entry) %></span>
        <% end %>
      </div>
    <% end %>

    <% if display_word_rows.present? %>
      <div class="mt-2 grid grid-cols-[3.5rem_1fr_8rem] gap-x-3 gap-y-1 text-xs">
        <div class="text-slate-400">Slot</div>
        <div class="text-slate-400">Word</div>
        <div class="text-slate-400">Player</div>
        <% display_word_rows.each do |row| %>
          <div class="font-mono text-slate-300"><%= row_label(row) %></div>
          <div class="font-mono text-slate-100"><%= row_word(row) %></div>
          <div class="truncate text-slate-200"><%= row_player(row) %></div>
        <% end %>
      </div>
    <% else %>
      <div class="mt-2 text-sm text-slate-300">No word slots recognized yet.</div>
    <% end %>
  </section>
</div>