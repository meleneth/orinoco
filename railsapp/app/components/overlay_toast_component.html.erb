<div class="pointer-events-none mb-3 max-w-xl rounded-md border bg-slate-950/90 px-5 py-4 text-white shadow-2xl" style="border-color: <%= accent_color %>; box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45); animation: overlay-toast 7s ease-in-out forwards;">
  <% if title %>
    <div class="text-sm font-semibold uppercase tracking-wide" style="color: <%= accent_color %>"><%= title %></div>
  <% end %>
  <div class="mt-1 text-2xl font-black leading-tight"><%= message %></div>
</div>
