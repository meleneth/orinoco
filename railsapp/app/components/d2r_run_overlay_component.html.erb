<div class="pointer-events-auto absolute right-6 top-6 w-96 rounded-lg border border-slate-700 bg-slate-950/85 p-4 text-slate-100 shadow-lg backdrop-blur" data-controller="d2r-run" data-d2r-run-url-value="/d2r/run" data-d2r-run-history-url-value="/d2r/runs">
  <%= helpers.turbo_stream_from :d2r_events, data: { d2r_run_target: "stream" } %>
  <div class="flex items-center justify-between">
    <h2 class="font-semibold uppercase tracking-wider text-cyan-300">D2R Run</h2>
    <span class="font-mono text-xl" data-d2r-run-target="elapsed">00:00:00</span>
  </div>
  <div class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
    <span class="text-slate-400">Level</span><span data-d2r-run-target="level">?</span>
    <span class="text-slate-400">Area</span><span data-d2r-run-target="area">Unknown area</span>
    <span class="text-slate-400">Difficulty</span><span data-d2r-run-target="difficulty">?</span>
    <span class="text-slate-400">Terror</span><span data-d2r-run-target="terrorZones">No active zones</span>
    <span class="text-slate-400">Run</span><span data-d2r-run-target="run">Unclassified run</span>
    <span class="text-slate-400">Step</span><span class="font-mono" data-d2r-run-target="step">No active step</span>
  </div>
  <h3 class="mt-4 border-t border-slate-700 pt-3 text-xs font-semibold uppercase text-slate-400">Recent events</h3>
  <%= render D2rLiveProjectionComponent.new(state: state) %>
  <div class="mt-3 flex justify-between border-t border-slate-700 pt-3">
    <h3 class="text-xs font-semibold uppercase text-slate-400">Run history</h3>
    <%= link_to "Full log", d2r_log_path, target: "_blank", rel: "noopener", class: "ml-auto mr-2 text-xs text-cyan-300 hover:underline" %>
    <button type="button" class="rounded border border-cyan-700 px-2 py-1 text-xs text-cyan-300" data-action="click->d2r-run#toggleHistory" data-d2r-run-target="historyToggle">Browse runs</button>
  </div>
  <section class="mt-2 hidden max-h-[45vh] overflow-y-auto text-xs" data-d2r-run-target="historyPanel">
    <div class="mb-2 flex items-center justify-between gap-2">
      <button type="button" class="rounded border border-slate-600 px-2 py-1" data-action="click->d2r-run#previousPage">Previous</button>
      <span data-d2r-run-target="historyPage">Page 1</span>
      <button type="button" class="rounded border border-slate-600 px-2 py-1" data-action="click->d2r-run#nextPage">Next</button>
    </div>
    <ol class="space-y-1" data-d2r-run-target="historyList"></ol>
    <div class="mt-2 whitespace-pre-wrap border-t border-slate-700 pt-2 font-mono text-xs" data-d2r-run-target="historyDetails">Select a run to inspect its steps and events.</div>
  </section>
  <h3 class="mt-4 border-t border-slate-700 pt-3 text-xs font-semibold uppercase text-slate-400">Run splits</h3>
  <ol class="mt-2 space-y-1 font-mono text-xs" data-d2r-run-target="splits"></ol>
</div>
