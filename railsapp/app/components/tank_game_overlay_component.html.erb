<%= helpers.turbo_stream_from "tank_game:overlay" %>

<div
  id="tank_game_overlay"
  class="fixed inset-0 overflow-hidden bg-transparent"
  data-controller="tank-game-animation"
>
  <script type="application/json" data-tank-game-animation-target="volley"><%= ERB::Util.json_escape(last_volley.to_json) %></script>

  <svg viewBox="0 0 1920 1080" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" role="img" aria-label="TankGame">
    <defs>
      <linearGradient id="tank_game_panel" x1="0" x2="1" y1="0" y2="1">
        <stop offset="0%" stop-color="#10121c" stop-opacity="0.72" />
        <stop offset="100%" stop-color="#2c1e31" stop-opacity="0.42" />
      </linearGradient>
      <filter id="tank_game_shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#10121c" flood-opacity="0.55" />
      </filter>
    </defs>

    <rect x="0" y="0" width="1920" height="1080" fill="#10121c" opacity="0.22" />

    <% if phase == "idle" %>
      <g filter="url(#tank_game_shadow)">
        <rect x="600" y="410" width="720" height="210" rx="8" fill="url(#tank_game_panel)" stroke="#36c5f4" stroke-width="2" />
        <text x="960" y="490" text-anchor="middle" fill="#ffffff" font-size="54" font-weight="800">TankGame</text>
        <text x="960" y="555" text-anchor="middle" fill="#6dead6" font-size="34"><%= status_text %></text>
      </g>
    <% else %>
      <g filter="url(#tank_game_shadow)">
        <rect x="32" y="28" width="760" height="106" rx="8" fill="url(#tank_game_panel)" stroke="#3388de" stroke-width="2" />
        <text x="64" y="72" fill="#ffffff" font-size="32" font-weight="800">TankGame</text>
        <text x="64" y="112" fill="#f6e8e0" font-size="26"><%= status_text %></text>
      </g>
      <% if countdown_text %>
        <g filter="url(#tank_game_shadow)">
          <rect x="1500" y="28" width="360" height="88" rx="8" fill="url(#tank_game_panel)" stroke="#f3a833" stroke-width="2" />
          <text x="1680" y="84" text-anchor="middle" fill="#f7f3b7" font-size="36" font-weight="800"><%= countdown_text %></text>
        </g>
      <% end %>

      <% if terrain.any? %>
        <polygon points="<%= terrain_points %>" fill="#1e4044" stroke="#9de64e" stroke-width="4" />
        <polyline points="<%= terrain.map { |point| "#{point.fetch("x", 0)},#{point.fetch("y", 900)}" }.join(" ") %>" fill="none" stroke="#5ab552" stroke-width="5" />
      <% end %>

      <g data-tank-game-animation-target="effects" pointer-events="none"></g>

      <% tanks.each_with_index do |tank, index| %>
        <% player = player_for(tank.fetch("login", "")) %>
        <% active = player.fetch("active", true) %>
        <% barrel_x, barrel_y = barrel_end(tank, player) %>
        <% x = tank.fetch("x", 0).to_f %>
        <% y = tank.fetch("y", 0).to_f %>
        <g filter="url(#tank_game_shadow)" opacity="<%= active ? 1 : 0.45 %>">
          <line x1="<%= tank.fetch("turret_x", x) %>" y1="<%= tank.fetch("turret_y", y - 22) %>" x2="<%= barrel_x %>" y2="<%= barrel_y %>" stroke="#10121c" stroke-width="12" stroke-linecap="round" />
          <line x1="<%= tank.fetch("turret_x", x) %>" y1="<%= tank.fetch("turret_y", y - 22) %>" x2="<%= barrel_x %>" y2="<%= barrel_y %>" stroke="#f6e8e0" stroke-width="5" stroke-linecap="round" />
          <rect x="<%= x - 34 %>" y="<%= y - 31 %>" width="68" height="34" rx="7" fill="<%= tank_color(index, active) %>" stroke="#10121c" stroke-width="4" />
          <circle cx="<%= x %>" cy="<%= y - 33 %>" r="18" fill="<%= tank_color(index, active) %>" stroke="#10121c" stroke-width="4" />
          <rect x="<%= x - 42 %>" y="<%= y %>" width="84" height="16" rx="8" fill="#2c1e31" />
          <rect x="<%= x - 44 %>" y="<%= y + 30 %>" width="88" height="48" rx="6" fill="#10121c" opacity="0.7" />
          <text x="<%= x %>" y="<%= y + 52 %>" text-anchor="middle" fill="#ffffff" font-size="20" font-weight="700"><%= player.fetch("display_name", tank.fetch("login", "")) %></text>
          <text x="<%= x %>" y="<%= y + 73 %>" text-anchor="middle" fill="#deceed" font-size="18"><%= player.fetch("health", 0) %> HP W<%= player.fetch("weapon", 1) %></text>
        </g>
      <% end %>

      <% if phase == "signup" && players.any? %>
        <g filter="url(#tank_game_shadow)">
          <rect x="32" y="150" width="420" height="<%= [players.length * 34 + 46, 92].max %>" rx="8" fill="url(#tank_game_panel)" />
          <text x="56" y="190" fill="#ffffff" font-size="26" font-weight="800">Players</text>
          <% players.each_with_index do |player, index| %>
            <text x="56" y="<%= 226 + (index * 34) %>" fill="#f6e8e0" font-size="24"><%= player.fetch("display_name") %></text>
          <% end %>
        </g>
      <% end %>
    <% end %>
  </svg>
</div>