<% content_for :title, "Event Pipeline Queue" %>

<section class="mx-auto max-w-6xl py-8">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <%= link_to "Event Pipeline", admin_event_pipeline_path, class: "text-sm text-blue-400 hover:text-blue-300" %>
      <h1 class="mt-2 break-all font-mono text-2xl font-semibold text-slate-950 dark:text-slate-50"><%= params[:id] %></h1>
      <% if @queue %>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          Visible <%= @queue.visible %>, in flight <%= @queue.in_flight %>, delayed <%= @queue.delayed %>
        </p>
        <% if @queue.in_flight.positive? %>
          <p class="mt-1 text-xs text-amber-600 dark:text-amber-300">
            In-flight message bodies are hidden by SQS until their visibility timeout expires or the worker deletes them.
          </p>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @error %>
    <div class="mb-6 border border-red-800 bg-red-950/40 p-4 text-sm text-red-100">
      <%= @error.class %>: <%= @error.message %>
    </div>
  <% end %>

  <div class="space-y-4">
    <% if @messages.empty? %>
      <div class="border border-slate-800 bg-slate-950 p-4 text-sm text-slate-400">No messages visible right now.</div>
    <% end %>

    <% @messages.each do |message| %>
      <article class="border border-slate-800 bg-slate-950">
        <header class="space-y-2 border-b border-slate-800 px-4 py-3 font-mono text-xs text-slate-400">
          <div><%= message.message_id.presence || "message" %></div>
          <% if message.attributes.present? %>
            <dl class="grid gap-2 text-[11px] sm:grid-cols-3">
              <% message.attributes.slice("ApproximateReceiveCount", "SentTimestamp", "ApproximateFirstReceiveTimestamp").each do |name, value| %>
                <div>
                  <dt class="text-slate-500"><%= name %></dt>
                  <dd class="break-all text-slate-300"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          <% end %>
        </header>
        <pre class="overflow-auto p-4 text-xs leading-relaxed text-slate-100"><%= JSON.pretty_generate(message.parsed_body || message.body) %></pre>
      </article>
    <% end %>
  </div>
</section>