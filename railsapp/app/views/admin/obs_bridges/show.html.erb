<div class="space-y-8 text-gray-900 dark:text-gray-100">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold"><%= @bridge_definition.fetch(:label) %> Admin</h1>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Bridge ID:
        <span class="font-mono text-gray-900 dark:text-gray-100"><%= @bridge[:bridge_id] %></span>
      </p>
    </div>

    <nav class="flex flex-wrap gap-2" aria-label="Bridge selector">
      <% @bridges.each do |id, definition| %>
        <% active = id == @bridge[:bridge_id] %>
        <%= link_to definition.fetch(:label),
          admin_obs_bridge_path(id),
          class: [
            "rounded px-3 py-2 text-sm font-medium",
            active ? "bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-950" : "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
          ].join(" ") %>
      <% end %>
    </nav>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= button_to "Start bridge",
      start_admin_obs_bridge_path(@bridge[:bridge_id]),
      method: :post,
      class: "rounded bg-green-600 px-4 py-2 text-white hover:bg-green-700 dark:bg-green-500 dark:hover:bg-green-400" %>

    <%= button_to "Stop bridge",
      stop_admin_obs_bridge_path(@bridge[:bridge_id]),
      method: :post,
      class: "rounded bg-red-600 px-4 py-2 text-white hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-400" %>

    <% if @bridge_definition.fetch(:refresh) %>
      <%= button_to "Refresh inventory",
        refresh_admin_obs_bridge_path(@bridge[:bridge_id]),
        method: :post,
        class: "rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400" %>
    <% end %>
  </div>

  <% if @bridge_definition.fetch(:capture_all) %>
    <div class="rounded border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900">
      <h2 class="mb-4 text-lg font-medium">Capture all events</h2>

      <%= form_with url: capture_all_admin_obs_bridge_path(@bridge[:bridge_id]), method: :post, local: true, class: "flex items-end gap-3" do |form| %>
        <div>
          <%= form.label :duration_seconds, "Duration (seconds)", class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= form.number_field :duration_seconds,
            value: 900,
            min: 1,
            class: "rounded border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:placeholder:text-gray-500" %>
        </div>

        <%= form.submit "Start capture window",
          class: "rounded bg-purple-600 px-4 py-2 text-white hover:bg-purple-700 dark:bg-purple-500 dark:hover:bg-purple-400" %>
      <% end %>
    </div>
  <% end %>

  <%= turbo_stream_from "obs_bridge_status:#{@bridge[:bridge_id]}" %>

  <%= render "status_panel", status: @bridge[:status], bridge_id: @bridge[:bridge_id] %>


  <% if @d2r_status %>
    <% capture = @d2r_status.fetch(:capture) %>
    <% processing = @d2r_status.fetch(:processing) %>
    <% presence = @d2r_status.fetch(:presence) %>
    <% pending = @d2r_status.fetch(:pending) %>
    <section class="rounded border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900">
      <h2 class="text-lg font-semibold">Diablo II: Resurrected observer</h2>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
        Capture and processor diagnostics are independent. Reload to see the latest worker activity.
        A missing or old timestamp indicates the corresponding worker is not reporting.
      </p>
      <div class="mt-4 grid grid-cols-1 gap-3 text-sm md:grid-cols-2 xl:grid-cols-3">
        <div><strong>Master switch:</strong> <%= @d2r_config.enabled? ? "enabled" : "disabled" %></div>
        <div><strong>OBS source:</strong> <%= @d2r_config.screenshot_source_name.presence || "(not configured)" %></div>
        <div><strong>Override:</strong> <%= @d2r_status.fetch(:mode) %></div>
        <div><strong>Capture worker:</strong> <%= capture["reason"] || "no heartbeat" %></div>
        <div><strong>Last capture decision:</strong> <%= capture["at"] || "never" %></div>
        <div><strong>Processor:</strong> <%= processing["reason"] || "no results" %></div>
        <div><strong>Last processed frame:</strong> <%= processing["at"] || "never" %></div>
        <div><strong>Screen classified:</strong> <%= processing["screen"].presence || presence["screen"].presence || "unknown" %></div>
        <div><strong>Game detected:</strong> <%= presence["active"] == true ? "yes" : "no" %></div>
        <div><strong>Consecutive unknowns:</strong> <%= presence.fetch("misses", "unknown") %></div>
        <div><strong>Last presence observation:</strong> <%= presence["observed_at"] || "never" %></div>
        <div><strong>Capture pending since:</strong> <%= pending["requested_at"] || "none" %></div>
      </div>
      <% [capture["error"], processing["error"]].compact.each do |error| %>
        <pre class="mt-3 whitespace-pre-wrap rounded bg-red-50 p-2 text-sm text-red-800 dark:bg-red-950 dark:text-red-200"><%= error %></pre>
      <% end %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% { "auto" => "Automatic", "force_on" => "Force scanning", "force_off" => "Force paused" }.each do |mode, label| %>
          <%= button_to label, d2r_mode_admin_obs_bridge_path(@bridge[:bridge_id]),
            method: :post, params: { mode: mode },
            disabled: @d2r_status.fetch(:mode) == mode,
            class: "rounded border border-gray-400 px-3 py-2 text-sm hover:bg-gray-100 disabled:opacity-40 dark:hover:bg-gray-800" %>
        <% end %>
        <%= link_to "Configure source and master switch", basic_setup_index_path,
          class: "rounded border border-gray-400 px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-800" %>
      </div>
      <p class="mt-3 text-xs text-gray-600 dark:text-gray-400">
        Force scanning bypasses game-presence standby, not the master switch, OBS connectivity, or the in-flight screenshot gate.
        Force paused stops screenshot requests. Overrides persist until changed back to Automatic.
      </p>
    </section>
  <% end %>

  <% if @bridge_definition.fetch(:refresh) %>
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-medium">Scenes</h2>
        <div class="text-sm text-gray-500 dark:text-gray-400">
          <%= @bridge[:scenes].length %> scenes
        </div>
      </div>

      <% if @bridge[:scenes].empty? %>
        <div class="rounded border border-gray-200 bg-white p-4 text-gray-600 shadow-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400">
          No scene inventory in Redis yet.
        </div>
      <% else %>
        <% @bridge[:scenes].each do |scene| %>
          <div class="rounded border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900">
            <div class="mb-3 flex items-center justify-between">
              <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">
                <%= scene["sceneName"] || "(unnamed scene)" %>
              </h3>
              <span class="text-sm text-gray-500 dark:text-gray-400">
                <%= scene["items"].length %> items
              </span>
            </div>

            <% if scene["items"].empty? %>
              <div class="text-sm text-gray-500 dark:text-gray-400">No items recorded for this scene.</div>
            <% else %>
              <div class="overflow-x-auto">
                <table class="min-w-full border-collapse text-sm">
                  <thead>
                    <tr class="border-b border-gray-200 text-left dark:border-gray-700">
                      <th class="px-3 py-2 font-medium text-gray-600 dark:text-gray-300">Scene item ID</th>
                      <th class="px-3 py-2 font-medium text-gray-600 dark:text-gray-300">Source name</th>
                      <th class="px-3 py-2 font-medium text-gray-600 dark:text-gray-300">Enabled</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% scene["items"].each do |item| %>
                      <tr class="border-b border-gray-200 last:border-b-0 dark:border-gray-800">
                        <td class="px-3 py-2 font-mono text-gray-900 dark:text-gray-100"><%= item["sceneItemId"] || "-" %></td>
                        <td class="px-3 py-2 font-mono text-gray-900 dark:text-gray-100"><%= item["sourceName"] || "-" %></td>
                        <td class="px-3 py-2 font-mono text-gray-900 dark:text-gray-100"><%= item["sceneItemEnabled"] %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>