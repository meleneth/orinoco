<%= render partial: "diorama_node_forms/common_fields", locals: { form: form, editor: editor } %>

<div class="space-y-2">
  <%= label_tag "diorama_node_form_condition", "Condition", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
  <%= select_tag "diorama_node_form[condition]",
    options_for_select(editor.condition_options.map { |option| [option, option] }, editor.condition),
    include_blank: "Select a condition",
    id: "diorama_node_form_condition",
    class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
</div>

<div class="space-y-2">
  <%= label_tag "diorama_node_form_args_affordance", "Args affordance", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
  <%= text_field_tag "diorama_node_form[args_affordance]", editor.args_affordance, id: "diorama_node_form_args_affordance", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
</div>

<div class="space-y-2">
  <%= label_tag "diorama_node_form_args_scene_name", "Args scene name", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
  <%= text_field_tag "diorama_node_form[args_scene_name]", editor.args_scene_name, id: "diorama_node_form_args_scene_name", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
</div>

<%= render partial: "diorama_node_forms/advanced_data", locals: { editor: editor } %>
