<%= render partial: "diorama_node_forms/common_fields", locals: { form: form, editor: editor } %>

<div class="space-y-2">
  <%= label_tag "diorama_node_form_asset_type", "Asset type", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
  <%= select_tag "diorama_node_form[asset_type]",
    options_for_select([["Image", "image"], ["Overlay text box", "overlay_text_box"]], editor.asset_type),
    include_blank: "Select an asset type",
    id: "diorama_node_form_asset_type",
    class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
</div>

<% if editor.asset_type.blank? || editor.asset_type == "image" %>
  <% image_value = editor.image_value %>

  <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200">
    Inline raster images should stay small. SVG data belongs in the textarea below as XML text.
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_storage", "Image storage", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= select_tag "diorama_node_form[image_storage]",
        options_for_select(DioramaImageValue::SUPPORTED_STORAGE.map { |option| [option, option] }, image_value.storage),
        include_blank: "Select storage",
        id: "diorama_node_form_image_storage",
        class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_media_type", "Image media type", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= select_tag "diorama_node_form[image_media_type]",
        options_for_select(DioramaImageValue::SUPPORTED_MEDIA_TYPES.map { |option| [option, option] }, image_value.media_type),
        include_blank: "Select media type",
        id: "diorama_node_form_image_media_type",
        class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_encoding", "Image encoding", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= text_field_tag "diorama_node_form[image_encoding]", editor.image_encoding, id: "diorama_node_form_image_encoding", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_asset_ref", "Image asset ref", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= text_field_tag "diorama_node_form[image_asset_ref]", editor.image_asset_ref, id: "diorama_node_form_image_asset_ref", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <div class="space-y-2">
    <%= label_tag "diorama_node_form_image_data", "Image data", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= text_area_tag "diorama_node_form[image_data]", editor.image_data, id: "diorama_node_form_image_data", rows: 6, class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_sha256", "Image sha256", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= text_field_tag "diorama_node_form[image_sha256]", editor.image_sha256, id: "diorama_node_form_image_sha256", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_byte_size", "Image byte size", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= number_field_tag "diorama_node_form[image_byte_size]", editor.image_byte_size, id: "diorama_node_form_image_byte_size", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_width", "Image width", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= number_field_tag "diorama_node_form[image_width]", editor.image_width, id: "diorama_node_form_image_width", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_image_height", "Image height", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= number_field_tag "diorama_node_form[image_height]", editor.image_height, id: "diorama_node_form_image_height", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <% if editor.inline_svg_preview? %>
    <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-950">
      <p class="text-sm font-medium text-slate-700 dark:text-slate-300">Inline preview</p>
      <div class="mt-3 max-w-full overflow-auto rounded-md border border-slate-200 bg-white p-3 dark:border-slate-800">
        <%= image_tag image_value.data_url, alt: editor.name, class: "max-h-64 max-w-full" %>
      </div>
    </div>
  <% end %>
<% end %>

<% if editor.asset_type.blank? || editor.asset_type == "overlay_text_box" %>
  <div class="rounded-lg border border-blue-200 bg-blue-50 p-3 text-sm text-blue-900 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-200">
    Overlay text boxes use a safe template and constrained renderer key. No arbitrary Ruby or HTML is executed.
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_renderer_key", "Renderer key", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= select_tag "diorama_node_form[renderer_key]",
        options_for_select(Overlay::RendererRegistry.keys.map { |key| [key.humanize, key] }, editor.renderer_key.presence || "text_box"),
        include_blank: "Select renderer",
        id: "diorama_node_form_renderer_key",
        class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_element_key", "Element key", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= text_field_tag "diorama_node_form[element_key]", editor.element_key, id: "diorama_node_form_element_key", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_style_preset", "Style preset", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= select_tag "diorama_node_form[style_preset]",
        options_for_select(Overlay::StylePreset.keys.map { |key| [key.humanize, key] }, editor.style_preset.presence || "obs_panel"),
        include_blank: "Select style preset",
        id: "diorama_node_form_style_preset",
        class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_timer_key", "Timer key", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= text_field_tag "diorama_node_form[timer_key]", editor.timer_key, id: "diorama_node_form_timer_key", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <div class="space-y-2">
    <%= label_tag "diorama_node_form_content_template", "Content template", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= text_area_tag "diorama_node_form[content_template]", editor.content_template, id: "diorama_node_form_content_template", rows: 4, class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_duration_ms", "Duration ms", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= number_field_tag "diorama_node_form[duration_ms]", editor.duration_ms, id: "diorama_node_form_duration_ms", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_mode", "Mode", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= select_tag "diorama_node_form[mode]",
        options_for_select([["Countdown", "countdown"]], editor.mode.presence || "countdown"),
        include_blank: false,
        id: "diorama_node_form_mode",
        class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2">
      <%= label_tag "diorama_node_form_starts_on", "Starts on", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= text_field_tag "diorama_node_form[starts_on]", editor.starts_on, id: "diorama_node_form_starts_on", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>

    <div class="space-y-2">
      <%= label_tag "diorama_node_form_stops_on", "Stops on", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= text_field_tag "diorama_node_form[stops_on]", editor.stops_on, id: "diorama_node_form_stops_on", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
    </div>
  </div>

  <div class="space-y-2">
    <%= label_tag "diorama_node_form_tick_rate_ms", "Tick rate ms", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= number_field_tag "diorama_node_form[tick_rate_ms]", editor.tick_rate_ms, id: "diorama_node_form_tick_rate_ms", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
  </div>
<% end %>

<%= render partial: "diorama_node_forms/advanced_data", locals: { editor: editor } %>
