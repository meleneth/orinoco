<% content_for :title, "D2R Run ##{@run.id}" %>
<section class="mx-auto max-w-6xl py-8">
  <%= link_to "← Run log", d2r_log_path, class: "text-sm text-cyan-300 hover:underline" %>
  <header class="my-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold text-cyan-300"><%= @run.run_kind.presence&.titleize || "Unclassified run" %></h1>
      <p class="mt-2 text-sm text-slate-400"><%= l(@run.started_at, format: :long) %> · <%= @run.difficulty.presence || "Unknown difficulty" %> · Level <%= @run.character_level || "?" %></p>
      <p class="mt-1 break-all font-mono text-xs text-slate-500">Game ID: <%= @run.game_id %></p>
    </div>
    <div class="text-right">
      <div class="font-mono text-xl"><%= distance_of_time_in_words(@run.started_at, @run.ended_at || Time.current) %></div>
      <div class="text-xs text-slate-400"><%= @run.outcome.humanize %> · Game <%= @run.ended_at ? "ended" : "open" %><%= @run.repeated? ? " · Repeat run" : "" %></div>
    </div>
  </header>
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-lg border border-slate-800 bg-slate-950 p-5">
      <h2 class="mb-3 text-lg font-semibold">Route & splits</h2>
      <p class="mb-3 text-sm text-slate-400">Last area: <%= @run.area.presence || "Unknown" %></p>
      <% if @run.run_confidence %>
        <p class="mb-3 text-sm text-slate-400">Classification confidence: <%= (@run.run_confidence * 100).round %>%</p>
      <% end %>
      <% if @run.run_evidence.present? %>
        <h3 class="mb-1 text-xs uppercase text-slate-500">Evidence</h3>
        <ol class="mb-4 list-inside list-decimal text-sm text-slate-300">
          <% @run.run_evidence.each do |evidence| %><li><%= evidence.is_a?(String) ? evidence : evidence.to_json %></li><% end %>
        </ol>
      <% end %>
      <ol class="space-y-2">
        <% @run.steps.each do |step| %>
          <li class="flex justify-between gap-4 border-b border-slate-800 pb-2 text-sm">
            <span><%= step["name"] %></span>
            <span class="font-mono text-slate-300"><%= step["seconds"] ? "#{step["seconds"].round(1)}s" : "?" %></span>
          </li>
        <% end %>
        <% if @run.current_step.present? %>
          <li class="flex justify-between gap-4 text-sm text-cyan-300">
            <span><%= @run.current_step["name"] %> (current)</span>
            <span class="font-mono">Active</span>
          </li>
        <% end %>
      </ol>
      <% if @run.steps.empty? && @run.current_step.blank? %><p class="text-sm text-slate-500">No area splits observed.</p><% end %>
    </section>
    <section class="rounded-lg border border-slate-800 bg-slate-950 p-5">
      <h2 class="mb-1 text-lg font-semibold">Loot sightings</h2>
      <p class="mb-4 text-xs text-amber-300">Sighted on screen, not confirmed picked up or identified.</p>
      <% if @run.loot_sightings.any? %>
        <table class="w-full text-sm">
          <thead class="text-left text-xs uppercase text-slate-500"><tr><th class="pb-2">Seen</th><th class="pb-2">Kind</th><th class="pb-2">Name</th><th class="pb-2">Confidence</th></tr></thead>
          <tbody class="divide-y divide-slate-800">
            <% @run.loot_sightings.sort_by { |s| s["at"].to_s }.each do |sighting| %>
              <tr><td class="py-2 pr-3 whitespace-nowrap"><%= sighting["at"].present? ? l(Time.iso8601(sighting["at"]), format: :time) : "?" %></td>
                <td class="py-2 pr-3"><%= sighting["kind"] %></td>
                <td class="py-2 pr-3 <%= sighting["kind"] == "rune" ? "text-amber-300" : "text-yellow-200" %>"><%= sighting["name"] %></td>
                <td class="py-2"><%= sighting["confidence"] || "candidate" %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% else %><p class="text-sm text-slate-500">No loot sightings recorded.</p><% end %>
      <% if @drops.any? %>
        <p class="mt-4 border-t border-slate-800 pt-3 text-xs text-slate-500"><%= @drops.size %> durable drop records associated with this run.</p>
      <% end %>
    </section>
  </div>
  <section class="mt-6 rounded-lg border border-slate-800 bg-slate-950 p-5">
    <h2 class="mb-4 text-lg font-semibold">Detection timeline (<%= @run.events.size %>)</h2>
    <% if @run.events.empty? %><p class="text-sm text-slate-500">No detection events recorded.</p><% end %>
    <ol class="space-y-2">
      <% @run.events.each do |event| %>
        <li class="flex flex-wrap gap-x-4 gap-y-1 border-b border-slate-800 pb-2 text-sm">
          <time class="font-mono text-slate-400"><%= event["at"].present? ? l(Time.iso8601(event["at"]), format: :time) : "?" %></time>
          <span class="font-medium text-slate-200"><%= event["type"] %></span>
          <% if event["payload"].present? %><code class="min-w-0 break-all text-xs text-slate-500"><%= event["payload"].to_json %></code><% end %>
        </li>
      <% end %>
    </ol>
  </section>
</section>
