<% content_for :title, "D2R Characters" %>
<section class="mx-auto max-w-6xl py-8">
  <h1 class="mb-2 text-3xl font-semibold text-cyan-300">Character progression</h1>
  <p class="mb-6 text-sm text-slate-400">Open the character sheet in game to confirm identity, level and observed stats.</p>
  <div class="grid gap-4 md:grid-cols-2">
    <% @characters.each do |character| %>
      <%= link_to d2r_character_path(character), class: "block rounded-lg border border-slate-700 bg-slate-950 p-5 hover:border-cyan-600" do %>
        <h2 class="text-xl font-semibold text-cyan-300"><%= character.name %></h2>
        <p class="text-sm text-slate-300"><%= character.character_class %> · Level <%= character.level || "?" %></p>
        <p class="mt-2 text-sm text-slate-400">XP: <%= character.experience ? number_with_delimiter(character.experience) : "Not observed" %></p>
      <% end %>
    <% end %>
  </div>
  <% if @characters.empty? %><p class="text-slate-400">No confirmed character identities yet.</p><% end %>
</section>
