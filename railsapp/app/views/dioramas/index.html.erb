<% content_for :title, "Dioramas" %>

<div class="mx-auto w-full max-w-6xl py-8">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Dioramas</h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
        User-editable no-code affordance graphs. Open a diorama to inspect its nodes, then edit the current node through a typed form.
      </p>
    </div>

    <% if @default_clip_show.nil? %>
      <%= button_to "Create default Clip Show",
        bootstrap_default_dioramas_path,
        method: :post,
        class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-500" %>
    <% end %>
  </div>

  <% if notice.present? %>
    <p class="mb-4 rounded-md bg-green-50 px-3 py-2 text-sm font-medium text-green-700 dark:bg-green-950 dark:text-green-300"><%= notice %></p>
  <% end %>

  <% if alert.present? %>
    <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm font-medium text-red-700 dark:bg-red-950 dark:text-red-300"><%= alert %></p>
  <% end %>

  <div class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-50">Import diorama</h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Upload a diorama JSON export. You can optionally import it under a different name.</p>

    <%= form_with url: import_dioramas_path, method: :post, scope: :diorama_import, multipart: true, local: true, class: "mt-4 grid gap-4 md:grid-cols-3 md:items-end" do %>
      <div class="space-y-2">
        <%= label_tag "diorama_import_file", "JSON file", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= file_field_tag "diorama_import[file]", id: "diorama_import_file", accept: ".json,application/json", class: "block w-full text-sm text-slate-700 dark:text-slate-300" %>
      </div>

      <div class="space-y-2">
        <%= label_tag "diorama_import_name", "Import as name", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= text_field_tag "diorama_import[name]", nil, id: "diorama_import_name", class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" %>
      </div>

      <div>
        <%= submit_tag "Import JSON", class: "inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white" %>
      </div>
    <% end %>
  </div>

  <% if @dioramas.empty? %>
    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-600 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
      No dioramas yet.
    </div>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @dioramas.each do |diorama| %>
        <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-50">
                <%= link_to diorama.name, diorama_path(diorama), class: "hover:underline" %>
              </h2>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= diorama.slug %></p>
            </div>

            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
              <%= diorama.visibility %>
            </span>
          </div>

          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-slate-500 dark:text-slate-400">Version</dt>
              <dd class="font-medium text-slate-900 dark:text-slate-100"><%= diorama.version %></dd>
            </div>
            <div>
              <dt class="text-slate-500 dark:text-slate-400">Nodes</dt>
              <dd class="font-medium text-slate-900 dark:text-slate-100"><%= diorama.nodes.size %></dd>
            </div>
          </dl>

          <% if diorama.description.present? %>
            <p class="mt-4 line-clamp-3 text-sm text-slate-600 dark:text-slate-300"><%= diorama.description %></p>
          <% end %>

          <div class="mt-5">
            <%= link_to "Open diorama",
              diorama_path(diorama),
              class: "inline-flex items-center rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white" %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
