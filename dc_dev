#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="development.env"
COMPOSE_FILE="compose/development-compose.yml"

## Load .env only if it exists
#[ -f "$ENV_FILE" ] && export $(grep -v '^#' "$ENV_FILE" | xargs)

# Inject UID/GID for Unix-like systems
if [[ "$OSTYPE" != "msys" && "$OSTYPE" != "win32" ]]; then
	export HOST_UID=$(id -u)
	export HOST_GID=$(id -g)

	if [[ -z "${OBS_WEBSOCKET_CONFIG:-}" ]]; then
		flatpak_obs_config="$HOME/.var/app/com.obsproject.Studio/config/obs-studio/plugin_config/obs-websocket/config.json"
		native_obs_config="${XDG_CONFIG_HOME:-$HOME/.config}/obs-studio/plugin_config/obs-websocket/config.json"
		if [[ -f "$flatpak_obs_config" ]]; then
			export OBS_WEBSOCKET_CONFIG="$flatpak_obs_config"
		elif [[ -f "$native_obs_config" ]]; then
			export OBS_WEBSOCKET_CONFIG="$native_obs_config"
		else
			export OBS_WEBSOCKET_CONFIG="/dev/null"
		fi
	fi
fi

compose=(docker compose --env-file development.env -f development-compose.yml -f development-overrides.yml)
if [[ "${1:-}" == "css" ]]; then
  shift
  case "${1:-}" in
    "")
      if [[ -s railsapp/app/assets/builds/tailwind.css ]]; then
        echo "Reusing existing Tailwind CSS (use ./dc_dev css --force to rebuild)."
        exit 0
      fi
      if ! docker image inspect orinoco/tailwind-builder >/dev/null 2>&1; then
        "${compose[@]}" build tailwind-builder
      fi
      ;;
    --force) "${compose[@]}" build --build-arg "TAILWIND_CACHE_BUST=$(date +%s%N)" tailwind-builder ;;
    *) echo "Usage: ./dc_dev css [--force]" >&2; exit 2 ;;
  esac
  exec "${compose[@]}" run --rm --no-deps --no-build tailwind-builder
fi

exec "${compose[@]}" "$@"
